# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------

APP_ENV=development
STRICT_PRODUCTION_CHECKS=false
SEED_DEMO_DATA=true
API_DOCS_ENABLED=true
RATE_LIMIT_ENABLED=true
MAX_UPLOAD_MB=8

# -----------------------------------------------------------------------------
# HOST / CORS
# -----------------------------------------------------------------------------

TRUSTED_HOSTS=localhost,127.0.0.1,192.168.1.2,api,hirealocals.com,www.hirealocals.com

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.2:3000,https://hirealocals.com,https://www.hirealocals.com

FRONTEND_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=https://hirealocals.com

# Local npm run dev / uvicorn setup
API_INTERNAL_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# DATABASE
# Local development uses the existing SQLite database.
# DO NOT delete backend/hirealocals.db
# -----------------------------------------------------------------------------

DATABASE_URL=sqlite:///./hirealocals.db

# These PostgreSQL values are kept for future production deployment only.
POSTGRES_DB=hirealocals
POSTGRES_USER=hirealocals
POSTGRES_PASSWORD=change-this-db-password


# -----------------------------------------------------------------------------
# AUTH / SECURITY
# -----------------------------------------------------------------------------

JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=720


# -----------------------------------------------------------------------------
# EMAIL
# Leave SMTP_HOST blank for local development.
# Emails will remain visible in Admin > Email Outbox.
# -----------------------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@hirealocals.com
SMTP_FROM_NAME=HireALocals
SMTP_USE_TLS=true


# -----------------------------------------------------------------------------
# PAYMENTS
# Active provider: SAFEPAY SANDBOX
# -----------------------------------------------------------------------------

PAYMENT_MODE=safepay_sandbox


# -----------------------------------------------------------------------------
# SAFEPAY SANDBOX
#
# Developer > API:
#   Public key
#   Secret key
#
# Developer > Endpoints:
#   Webhook shared secret
#
# Actual secret values chat / frontend / GitHub mein share na karein.
# -----------------------------------------------------------------------------

SAFEPAY_ENV=sandbox

SAFEPAY_ENV=sandbox
SAFEPAY_PUBLIC_KEY=sec_b58f223d-9d87-4aed-94a8-2653e4fed27b
SAFEPAY_SECRET_KEY=2b0c8c9c2ca2a7dd9778523d92c19d38ce9f8b4367fdd2983b4efc1822c854ba
SAFEPAY_WEBHOOK_SECRET=a2044edd48056a075051a0dc1854428e72cdf075cfbea0f8e555c3f9285d64c5

SAFEPAY_WEBHOOK_URL=https://api.hirealocals.com/api/payments/safepay/webhook
SAFEPAY_CURRENCY=USD

# Blank = HireALocals booking-specific URLs generate karega
SAFEPAY_CHECKOUT_SUCCESS_URL=
SAFEPAY_CHECKOUT_CANCEL_URL=


# -----------------------------------------------------------------------------
# Currently inactive. Future UK/US company setup ke liye code preserve rahega.
# -----------------------------------------------------------------------------







# -----------------------------------------------------------------------------
# LEGAL / POLICY VERSIONING
# Keep draft until final legal text is approved.
# -----------------------------------------------------------------------------

TERMS_VERSION=draft
PRIVACY_VERSION=draft
BOOKING_POLICY_VERSION=draft


# -----------------------------------------------------------------------------
# RELEASE
# -----------------------------------------------------------------------------

RELEASE_VERSION=3.3.0